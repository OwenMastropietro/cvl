        <type><ref refid="structcvl___mat" kindref="compound">cvl_Mat</ref></type>
        <definition>cvl_Mat cvl_imread</definition>
        <argsstring>(const char *filename)</argsstring>
        <name>cvl_imread</name>
        <param>
          <type>const char *</type>
          <declname>filename</declname>
        </param>
        <briefdescription>
<para>Reads an image from the specified file. </para>
        </briefdescription>
        <detaileddescription>
<para>The image format is detected from the file header, not the file extension.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>filename</parametername>
</parameternamelist>
<parameterdescription>
<para>Path to read the image from. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>A <ref refid="core_8h_1a4889e676319625eb11cdfb5d877f234eaab6bc5c3982c7fc9f175ed03a39ada7d" kindref="member">CVL_UINT8</ref> matrix containing the decoded image, or an empty matrix on failure.</para>
</simplesect>
See <ref refid="core_8h_1ac767ff544742f37f673eafcf50080033" kindref="member">cvl_format_t</ref>. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
