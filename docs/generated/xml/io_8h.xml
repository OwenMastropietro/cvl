      <memberdef kind="function" id="io_8h_1a894e7aaf13857fe871cf8e4de0ea33b9" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int cvl_imwrite</definition>
        <argsstring>(const char *filename, cvl_Mat *img)</argsstring>
        <name>cvl_imwrite</name>
        <param>
          <type>const char *</type>
          <declname>filename</declname>
        </param>
        <param>
          <type><ref refid="structcvl___mat" kindref="compound">cvl_Mat</ref> *</type>
          <declname>img</declname>
        </param>
        <briefdescription>
<para>Writes an image to the specified file. </para>
        </briefdescription>
        <detaileddescription>
<para>The image format is determined from the file extension.</para>
<para><table rows="6" cols="4"><row>
<entry thead="yes"><para>Format  </para>
</entry><entry thead="yes"><para>Read  </para>
</entry><entry thead="yes"><para>Write  </para>
</entry><entry thead="yes"><para>Requirements  </para>
</entry></row>
<row>
<entry thead="no"><para>PBM  </para>
</entry><entry thead="no"><para>binary <computeroutput>P4</computeroutput>  </para>
</entry><entry thead="no"><para><computeroutput>.pbm</computeroutput>  </para>
</entry><entry thead="no"><para>1 channel, <computeroutput><ref refid="core_8h_1a4889e676319625eb11cdfb5d877f234eaab6bc5c3982c7fc9f175ed03a39ada7d" kindref="member">CVL_UINT8</ref></computeroutput>, pixels must be <computeroutput>0</computeroutput> or <computeroutput>255</computeroutput>  </para>
</entry></row>
<row>
<entry thead="no"><para>PGM  </para>
</entry><entry thead="no"><para>binary <computeroutput>P5</computeroutput>  </para>
</entry><entry thead="no"><para><computeroutput>.pgm</computeroutput>  </para>
</entry><entry thead="no"><para>1 channel, <computeroutput><ref refid="core_8h_1a4889e676319625eb11cdfb5d877f234eaab6bc5c3982c7fc9f175ed03a39ada7d" kindref="member">CVL_UINT8</ref></computeroutput>  </para>
</entry></row>
<row>
<entry thead="no"><para>PPM  </para>
</entry><entry thead="no"><para>binary <computeroutput>P6</computeroutput>  </para>
</entry><entry thead="no"><para><computeroutput>.ppm</computeroutput>  </para>
</entry><entry thead="no"><para>3 channels, <computeroutput><ref refid="core_8h_1a4889e676319625eb11cdfb5d877f234eaab6bc5c3982c7fc9f175ed03a39ada7d" kindref="member">CVL_UINT8</ref></computeroutput>  </para>
</entry></row>
<row>
<entry thead="no"><para>PNG  </para>
</entry><entry thead="no"><para>stb  </para>
</entry><entry thead="no"><para><computeroutput>.png</computeroutput>  </para>
</entry><entry thead="no"><para><computeroutput><ref refid="core_8h_1a4889e676319625eb11cdfb5d877f234eaab6bc5c3982c7fc9f175ed03a39ada7d" kindref="member">CVL_UINT8</ref></computeroutput>, 1 to 4 channels  </para>
</entry></row>
<row>
<entry thead="no"><para>JPEG  </para>
</entry><entry thead="no"><para>stb  </para>
</entry><entry thead="no"><para><computeroutput>.jpg</computeroutput>  </para>
</entry><entry thead="no"><para><computeroutput><ref refid="core_8h_1a4889e676319625eb11cdfb5d877f234eaab6bc5c3982c7fc9f175ed03a39ada7d" kindref="member">CVL_UINT8</ref></computeroutput>, 1 or 3 channels, no padding between pixels  </para>
</entry></row>
</table>
</para>
<para><blockquote><para>JPEG is written at quality <computeroutput>90</computeroutput>. </para>
</blockquote></para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>filename</parametername>
</parameternamelist>
<parameterdescription>
<para>Path to write the image to. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>img</parametername>
</parameternamelist>
<parameterdescription>
<para>Image to write. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><computeroutput>0</computeroutput> on success, <computeroutput>1</computeroutput> on failure.</para>
</simplesect>
See <ref refid="core_8h_1ac767ff544742f37f673eafcf50080033" kindref="member">cvl_format_t</ref>. </para>
        </detaileddescription>
